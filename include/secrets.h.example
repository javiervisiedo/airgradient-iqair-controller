#pragma once

// Optional compile-time Wi-Fi credentials for bench development only.
// Matter BLE commissioning needs no compiled-in credentials, so most users do
// not need this file.
//
// Usage:
//   cp include/secrets.h.example include/secrets.h
//   # edit include/secrets.h with your 2.4 GHz Wi-Fi credentials
//
// NEVER commit include/secrets.h (it is gitignored) and NEVER use it in
// Wokwi simulation builds (`atoms3_sim` excludes secrets.h automatically).

#define WIFI_SSID "YOUR_2_4GHZ_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"
