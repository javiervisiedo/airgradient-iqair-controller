# Optional environment variables for local host-side helper scripts.
# Copy to `.env` (gitignored) and fill in only the variables you use:
#   cp .env.example .env

# Wokwi CLI simulation token (https://wokwi.com/dashboard/ci)
# Required only when running live cloud/CLI simulations via sim.sh
#WOKWI_CLI_TOKEN=replace-with-wokwi-token

# AirGradient Cloud helper script (.agents/skills/airgradient-api/scripts/ag_query.py)
# Not required by firmware (firmware uses AirGradient's local LAN HTTP API)
#AG_TOKEN=replace-with-airgradient-token
#AG_LOCATION_ID=12345

# Home Assistant helper script (.agents/skills/matter-smart-home/scripts/ha_query.py)
#HA_URL=http://homeassistant.local:8123
#HA_TOKEN=replace-with-ha-long-lived-token
